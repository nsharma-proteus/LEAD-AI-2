# /etc/nginx/sites-available/leadAI.proteustech.in
server {
    listen 80;
    server_name leadAI.proteustech.in leadai.proteustech.in;

    # Redirect HTTP to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name leadAI.proteustech.in leadai.proteustech.in;

    # SSL Certificates (will be auto-configured by certbot)
    # ssl_certificate /etc/letsencrypt/live/leadAI.proteustech.in/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/leadAI.proteustech.in/privkey.pem;

    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:3005;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
